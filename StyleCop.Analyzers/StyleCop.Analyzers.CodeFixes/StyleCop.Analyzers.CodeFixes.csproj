<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RootNamespace>StyleCop.Analyzers</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>False</IncludeSymbols>
    <CodeAnalysisRuleSet>..\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
    <PackageId>SharpStyleAnalyzers</PackageId>
    <Version>0.0.1.5</Version>
    <Authors>Alexander Täschner</Authors>
    <Copyright>Copyright (c) Alexander Täschner 2026</Copyright>
    <RepositoryUrl>https://github.com/AlexanderTaeschner/SharpStyleAnalyzers.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="bin\$(Configuration)\netstandard2.0\StyleCop.Analyzers.dll" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
    <None Include="bin\$(Configuration)\netstandard2.0\**\StyleCop.Analyzers.resources.dll" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
    <None Include="bin\$(Configuration)\netstandard2.0\StyleCop.Analyzers.CodeFixes.dll" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
    <None Include="bin\$(Configuration)\netstandard2.0\**\StyleCop.Analyzers.CodeFixes.resources.dll" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StyleCop.Analyzers\StyleCop.Analyzers.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>